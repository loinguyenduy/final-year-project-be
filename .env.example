# Existing application configuration is deployment-specific and intentionally
# omitted here. The AI Job Assistant is optional; the server and manual Job flow
# must continue to work when GEMINI_API_KEY/GEMINI_MODEL are empty.

GEMINI_API_KEY=
GEMINI_MODEL=
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_TURNS=8
AI_MAX_RECALCULATIONS=2
AI_SESSION_TTL_MINUTES=1440
AI_MAX_ACTIVE_SESSIONS_PER_CUSTOMER=3
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=20
AI_PROMPT_VERSION=job-diagnosis-v1
AI_ESTIMATOR_VERSION=historical-bid-v1
AI_MIN_PRICE_SAMPLES=3
AI_MAX_HISTORICAL_CANDIDATES=100
AI_MAX_COMPARABLE_RESULTS=30

# Guarded manual verification
AI_TEST_BASE_URL=http://localhost:8080/api/v1
AI_TEST_CUSTOMER_TOKEN=
AI_TEST_ALLOW_SESSION_MUTATION=false
AI_TEST_MESSAGES_JSON=
AI_TEST_PRICE_DECISION=CONTINUE_WITHOUT_ESTIMATE
AI_TEST_BUDGET_MIN=
AI_TEST_BUDGET_MAX=
AI_TEST_ALLOW_DISPOSABLE_JOB=false
AI_TEST_JOB_PAYLOAD_JSON=
AI_TEST_ABANDON_AFTER=true
