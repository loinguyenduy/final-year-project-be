NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Existing database/JWT/Cloudinary variables are also required.
DB_SYNC_ALTER=false
TRUST_PROXY=

COOKIE_REFRESH_MAX_AGE_MS=604800000
COOKIE_SAME_SITE=strict
COOKIE_SECURE=false
COOKIE_DOMAIN=

AUTH_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
ADMIN_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
ADMIN_MUTATION_RATE_LIMIT_WINDOW_MINUTES=5
ADMIN_MUTATION_RATE_LIMIT_MAX_REQUESTS=30

ENABLE_ADMIN_SEED=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=System Admin

KYC_SIGNED_URL_TTL_SECONDS=600
ADMIN_KYC_TEST_ALLOW_DB_MUTATION=false
ADMIN_TEST_BASE_URL=http://localhost:5000/api/v1
ADMIN_TEST_EMAIL=
ADMIN_TEST_PASSWORD=
ADMIN_TEST_SUBMISSION_ID=
ADMIN_TEST_DECISION=APPROVE
