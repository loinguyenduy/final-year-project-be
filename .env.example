# Job location geocoding (OpenCage free trial is intended for testing only)
OPENCAGE_API_KEY=
OPENCAGE_BASE_URL=https://api.opencagedata.com/geocode/v1/json
GEOCODING_TIMEOUT_MS=8000
GEOCODING_CACHE_TTL_MS=900000
GEOCODING_CACHE_MAX_ENTRIES=250

# Enable for one controlled startup after model changes, then set back to false.
DB_SYNC_ALTER=false
