# Core process and database
NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=
DB_DIALECT=postgres
DB_SYNC_ALTER=false
# Production non-empty alter escape hatch: leave unset unless the documented risk is accepted.
DB_SYNC_ALTER_ALLOW_NONEMPTY=

# Authentication
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
SOCKET_CORS_ORIGIN=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:5000
TRUST_PROXY=false
COOKIE_SAME_SITE=strict
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_REFRESH_MAX_AGE_MS=604800000

# Email: local Mailtrap Sandbox uses smtp; Railway production uses brevo-api.
EMAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:5000/api/v1/auth/facebook/callback

# PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_TOPUP_RETURN_URL=
PAYOS_TOPUP_CANCEL_URL=
# Legacy local aliases retained by source compatibility.
PUBLIC_BACKEND_URL=
API_PUBLIC_URL=
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=

# Media, AI, and geocoding
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENCAGE_API_KEY=

# Cron: timezone is optional; schedules retain existing defaults.
CRON_TIMEZONE=
JOB_WARRANTY_CRON_ENABLED=true
JOB_WARRANTY_CRON_SCHEDULE=* * * * *
WARRANTY_RELEASE_CRON_ENABLED=
WARRANTY_RELEASE_CRON_SCHEDULE=
JOB_WARRANTY_TEST_DELAY_MINUTES=

# Temporary, one-shot production bootstrap variables
BOOTSTRAP_ADMIN_CONFIRM=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_SERVICES_CONFIRM=
